APP_NAME=LinuxLab
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=linuxlab
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
VITE_APP_NAME="${APP_NAME}"

# Konfigurasi Terminal & Container Sesuai SPEC Bagian 4.2 & 18.2 (Q-01, Q-02)
TERMINAL_IMAGE=linuxlab-terminal:latest
TERMINAL_CPU_LIMIT=0.5
TERMINAL_MEMORY_LIMIT=256m
TERMINAL_SESSION_TTL=30
TERMINAL_MAX_SESSIONS=5
# Secret bersama gateway WebSocket internal (isi acak panjang di server, samakan dengan env gateway)
TERMINAL_GATEWAY_SECRET=

# Konfigurasi Sertifikat Sesuai SPEC Bagian 4.2 & 18.2 (Q-05)
CERTIFICATE_SIGNATORY_NAME=
CERTIFICATE_SIGNATORY_TITLE=

# Akun Administrator Awal (Seeder - kata sandi diisi di .env lokal Anda, jangan commit password)
ADMIN_NAME="Administrator LinuxLab"
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@linuxlab.local
ADMIN_PASSWORD=
